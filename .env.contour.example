# Closed-network deployment — runtime configuration.
#
#   cp .env.contour.example .env.local     # then fill in the addresses
#
# Copy this to `.env.local` on the contour host; docker-compose.contour.yml
# reads that file. Everything here is read at RUNTIME. Values that must be
# decided at BUILD time (the NEXT_PUBLIC_* flags) are build arguments instead —
# see docs/deploy-offline.md, they are baked into the browser bundle and cannot
# be changed by editing this file.
#
# Secrets live here and nowhere else: never in code, never in a NEXT_PUBLIC_*
# variable (those are compiled into the bundle every browser downloads).

# --- Qwen3 (LLM) --------------------------------------------------------------
# The `qwen` slot is a plain OpenAI-compatible client, so vLLM's /v1 works
# directly, and its label and icon already read correctly in the UI.
#
# QWEN_API_KEY MUST be non-empty. Only `ollama`, `lemonade` and `bedrock`
# activate on a base URL alone; every other slot is skipped without a key, and
# a skipped slot is unmanaged. Start vLLM with `--api-key <token>` and put that
# token here. If it already runs without a key, use OLLAMA_BASE_URL and
# OLLAMA_MODELS instead of these three — same transport, keyless, but the
# picker then shows "Ollama" and a foreign logo.
#
# QWEN_MODELS pins the model id server-side: exactly what GET /v1/models
# returns, not a marketing name.
#
# A private address (10.x, 172.16.x, 192.168.x) needs no extra permission here:
# the LLM transport applies no SSRF address policy. See ALLOW_LOCAL_NETWORKS at
# the bottom before assuming otherwise.
QWEN_BASE_URL=http://vllm.example.corp:8000/v1
QWEN_API_KEY=CHANGE-ME
QWEN_MODELS=

# Optional: pin the model used when the user has not chosen one.
# DEFAULT_MODEL=qwen:<model-id>

# --- MinerU (PDF parsing) -----------------------------------------------------
# Self-hosted. "pipeline" is the default backend; "hybrid-auto-engine" needs a
# GPU/device configuration on the MinerU side.
PDF_MINERU_BASE_URL=http://mineru.example.corp:8080
PDF_MINERU_API_KEY=
PDF_MINERU_BACKEND=pipeline

# Leave EMPTY. A request that selects self-hosted MinerU never falls back to
# MinerU Cloud implicitly — it fails loudly instead. Setting this to "true"
# would let documents leave the contour.
ALLOW_MINERU_CLOUD_FALLBACK=

# --- PostgreSQL ---------------------------------------------------------------
# An external, already-provisioned database.
#
# Three things to agree with the DBAs before first start:
#
#   1. The app creates its own schema. `ensureSchema()` runs CREATE TABLE IF NOT
#      EXISTS at startup, so the account needs DDL rights at least once. A
#      DML-only grant will not work.
#   2. It assumes the database is its own — there is no table prefix and no
#      schema switch in the code. Without a dedicated database, isolate with a
#      search_path: ...?options=-c%20search_path%3Dopenmaic
#   3. TLS beyond `sslmode=require` verifies the certificate against Node's
#      trust store, which does not contain the corporate CA. Mount the CA and
#      point NODE_EXTRA_CA_CERTS at it (docker-compose.contour.yml does both).
#
# pgvector is NOT used: there are no embeddings and no vector search in this
# application. The extension being present is harmless.
DATABASE_URL=postgres://openmaic:CHANGE-ME@postgres.example.corp:5432/openmaic?sslmode=require

# --- Server-backed persistence ------------------------------------------------
#
# READ THIS BEFORE ENABLING.
#
# The current persistence authentication is a shared development token. It
# provides NO user isolation: the owner identity comes from the client, so any
# user can read and write any other user's courses. That is what phases 3 and 4
# replace (docs/plan/auth.md). Until they land, enabling this means every
# author on the deployment shares one data space.
#
# Because of that, NODE_ENV=production refuses the scheme unless the opt-in
# below is set explicitly. Leaving all four unset keeps browser-local storage,
# where each person's work simply stays in their own browser — smaller, but
# honest about who can see what.
#
# NEXT_PUBLIC_PERSISTENCE and NEXT_PUBLIC_PERSISTENCE_TOKEN are BUILD-time and
# live in the build command, not here. The two values below must match them.
# PERSISTENCE_DEV_TOKEN=
# PERSISTENCE_ALLOW_INSECURE_DEV_AUTH=true

# --- Reverse proxy ------------------------------------------------------------
# nginx terminates TLS (and, from phase 5, Kerberos) in front of the app and
# overwrites these headers. Enable only when that is actually true: if a client
# can set x-forwarded-for itself, throttling and admission control become
# trivially bypassable.
TRUST_PROXY_HEADERS=true

# --- Agent runtime (pro workbench) --------------------------------------------
# Optional, and off by default: while disabled every /api/agent route answers
# 404. It needs DATABASE_URL above.
#
# MODEL_ROUTES is REQUIRED once the runtime is enabled — there is deliberately
# no fallback, and without the route every agent session fails at run start.
# The route must name a provider-prefixed model and an OpenAI transport.
# OPENMAIC_AGENT_RUNTIME_ENABLED=true
# MODEL_ROUTES='{"maic-agent-driver":{"model":"qwen:<model-id>","api":"openai-completions"}}'

# --- Local network policy -----------------------------------------------------
# Leave this UNSET.
#
# It lifts the block on private and loopback targets (cloud metadata addresses
# stay blocked either way). None of the contour's services need it:
#
#   LLM via the server config        — no policy is applied to that transport
#   MinerU via PDF_MINERU_BASE_URL   — server-configured providers are trusted
#   RENDER_SERVICE_URL               — operator-supplied, forwarded unguarded
#
# It is needed only if users type a base URL into the browser settings
# themselves, or if a local TTS/ASR service answers with URLs instead of bytes.
# Turn it on when a specific case demands it, and write down which one.
# ALLOW_LOCAL_NETWORKS=true

# --- Optional: MP4 export -----------------------------------------------------
# Set by docker-compose.contour.yml when the video-export profile runs.
# RENDER_SERVICE_URL=http://render-service:9000
